# Copy to /opt/omb/.env on the VPS (next to compose.prod.yml) and fill in. Never commit the real file.

# Public domain; DNS A/AAAA records for DOMAIN and files.DOMAIN point at the VPS.
DOMAIN=brain.example.com
# Ports on 127.0.0.1 that the server's Caddy proxies to (change them if another site uses these).
WEB_PORT=3000
S3_PORT=9000
# Image to run (CI pushes :latest and :<commit sha> to GHCR).
APP_IMAGE=ghcr.io/alfumi/one-more-brain:latest

# Database (internal only). Use a long random value: openssl rand -hex 24
POSTGRES_PASSWORD=

# Better Auth. openssl rand -hex 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outgoing email for magic links
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="One More Brain <no-reply@brain.example.com>"

# Object storage (RustFS on this server). openssl rand -hex 20
S3_REGION=us-east-1
S3_BUCKET=omb
S3_ACCESS_KEY=omb
S3_SECRET_KEY=

# Web Push. Generate once: bunx web-push generate-vapid-keys (works from any folder)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# AI enrichment
ANTHROPIC_API_KEY=
AI_MONTHLY_TOKENS=2000000

# Off-site backups (any S3-compatible bucket: Cloudflare R2, Backblaze B2, AWS S3...). Empty = local only.
OFFSITE_BUCKET=
OFFSITE_PROVIDER=Cloudflare
OFFSITE_ENDPOINT=
OFFSITE_REGION=auto
OFFSITE_ACCESS_KEY=
OFFSITE_SECRET_KEY=

# Browser extension ids allowed to sign in through /auth/extension (comma-separated).
# ealahabaammegndodbgendfkinpnflae = the CI/unpacked build; add the Chrome Web Store id later.
NUXT_PUBLIC_EXTENSION_IDS=ealahabaammegndodbgendfkinpnflae
