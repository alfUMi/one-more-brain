# Copy to .env (repo root) and adjust. All apps read this file in development.

# Postgres from docker/compose.dev.yml
DATABASE_URL=postgresql://omb:omb@localhost:55432/omb

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional in dev; the Google button hides when empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Mailpit in dev: UI at http://localhost:58025)
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="One More Brain <no-reply@localhost>"

# Object storage (RustFS in dev: console at http://localhost:59001)
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=omb
S3_ACCESS_KEY=omb
S3_SECRET_KEY=omb-secret

# Web Push (VAPID). Generate once per environment:
#   bun -e 'import { generateVAPIDKeys } from "web-push"; console.log(generateVAPIDKeys())'
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# AI enrichment (titles, tags, fuzzy reminders, text in images). Without a key items are just not enriched.
ANTHROPIC_API_KEY=
# Per-user monthly token allowance (input + output)
AI_MONTHLY_TOKENS=2000000
